+            <div class="ng-pose-scatter-label">${isAnchor ? `center (p${it.pitch.toFixed(0)} y${it.yaw.toFixed(0)})` : `p${it.pitch.toFixed(0)} y${it.yaw.toFixed(0)}`}</div>
+          `;
+          cell.ondblclick = () => removeItem(it);
+          stage.appendChild(cell);
+        });
