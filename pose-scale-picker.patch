diff --git a/static/styleNG.css b/static/styleNG.css
index 111ea00..d347518 100644
--- a/static/styleNG.css
+++ b/static/styleNG.css
@@ -1234,3 +1234,76 @@ html, body {
   margin-top: 6px;
 }
 .ng-immich-export-row .ng-btn:disabled { opacity: 0.5; }
+
+/* ---- Pose Picker / Shot Scale Picker panel sections ---- */
+.ng-picker-blurb {
+  font-size: 10px;
+  color: var(--ng-text-dim);
+  margin-bottom: 8px;
+  line-height: 1.4;
+}
+.ng-picker-empty {
+  font-size: 10px;
+  color: var(--ng-text-dim);
+  padding: 8px 0;
+}
+.ng-picker-controls {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+.ng-picker-slider-label {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  font-size: 10px;
+  color: var(--ng-text-dim);
+  margin-bottom: 2px;
+}
+.ng-picker-num {
+  width: 52px;
+  background: var(--ng-panel);
+  border: 1px solid var(--ng-border);
+  color: var(--ng-text);
+  padding: 2px 4px;
+  border-radius: 4px;
+  font-size: 10px;
+  text-align: right;
+}
+.ng-picker-num:disabled { color: var(--ng-text-dim); }
+.ng-picker-range { width: 100%; }
+.ng-picker-tolerance-row {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+.ng-picker-tolerance-label {
+  display: flex;
+  align-items: center;
+  gap: 5px;
+  font-size: 10px;
+  color: var(--ng-text-dim);
+  cursor: pointer;
+}
+.ng-picker-grid {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 6px;
+}
+.ng-picker-grid > div {
+  cursor: pointer;
+  visibility: hidden;
+}
+.ng-picker-grid img {
+  width: 100%;
+  aspect-ratio: 1;
+  object-fit: cover;
+  border-radius: 6px;
+  border: 2px solid var(--ng-border);
+  display: block;
+}
+.ng-picker-count {
+  font-size: 9px;
+  color: var(--ng-text-dim);
+  text-align: center;
+}
